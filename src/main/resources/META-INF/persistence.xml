<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <persistence-unit name="clinicPU" transaction-type="RESOURCE_LOCAL">

    <!-- ===== Fournisseur JPA ===== -->
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>


    <class>com.clinicmanag.clinic.model.User</class>
    <class>com.clinicmanag.clinic.model.Patient</class>
    <class>com.clinicmanag.clinic.model.Doctor</class>
    <class>com.clinicmanag.clinic.model.Admin</class>
    <class>com.clinicmanag.clinic.model.Staff</class>
    <class>com.clinicmanag.clinic.model.Department</class>
    <class>com.clinicmanag.clinic.model.Specialty</class>
    <class>com.clinicmanag.clinic.model.Availability</class>
    <class>com.clinicmanag.clinic.model.DoctorAbsence</class>
    <class>com.clinicmanag.clinic.model.Appointment</class>
    <class>com.clinicmanag.clinic.model.MedicalNote</class>


    <!-- ===== Propriétés Hibernate ===== -->
    <properties>

      <!-- Connexion PostgreSQL -->
      <property name="jakarta.persistence.jdbc.driver"
                value="org.postgresql.Driver"/>
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/clinic"/>
      <property name="jakarta.persistence.jdbc.user"
                value="postgres"/>
      <property name="jakarta.persistence.jdbc.password"
                value="postgres"/>

      <!-- Dialecte SQL PostgreSQL -->
      <property name="hibernate.dialect"
                value="org.hibernate.dialect.PostgreSQLDialect"/>

      <!-- Affichage SQL dans la console -->
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.format_sql" value="true"/>

      <!-- Génération automatique du schéma -->
      <property name="hibernate.hbm2ddl.auto" value="update"/>

    </properties>

  </persistence-unit>

</persistence>